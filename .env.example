# "desarrollo" en tu compu; "produccion" en el servidor (es el valor si no se define).
# En producción el servidor no arranca sin META_APP_SECRET, WA_VERIFY_TOKEN, WA_TOKEN,
# WA_PHONE_NUMBER_ID y GROQ_API_KEY. Si META_APP_SECRET está definido, la firma de Meta
# se valida siempre, también en desarrollo.
ENTORNO=desarrollo

# Groq (IA para entender mensajes y transcribir audios) — https://console.groq.com/keys
GROQ_API_KEY=
# Opcional. Solo si el modelo por defecto se da de baja: lista en
# https://console.groq.com/docs/models
GROQ_MODELO=

# WhatsApp Cloud API — developers.facebook.com > tu app > Casos de uso > Conectar en WhatsApp >
# Personalizar > Configuración de la API
WA_TOKEN=
WA_PHONE_NUMBER_ID=
# Inventalo vos; el mismo valor va en "Verify token" al configurar el webhook en Meta
WA_VERIFY_TOKEN=
# developers.facebook.com > tu app > Configuración de la app > Básica > Clave secreta de la app
META_APP_SECRET=
# Ponelo en true si con el número de prueba de Meta los mensajes a números argentinos no llegan
WA_AR_QUITAR_9=false

# Local: sqlite. En producción: la URL de Postgres (Railway la completa sola)
DATABASE_URL=sqlite:///./campo.db

# Tu número (y el de otros administradores), separados por coma, como los manda WhatsApp:
# 549 + característica sin 0 + número sin 15. Ej: 5492494123456
ADMIN_TELEFONOS=

# El número del bot como se ve en WhatsApp (ej: 5492494000000), para el link de las
# invitaciones (wa.me/<número>?text=<código>). Opcional: sin él, "invitar" da solo el código.
WA_NUMERO_BOT=

# Clave para guardar con HMAC los teléfonos de quienes prueban códigos equivocados. Obligatoria
# en producción. Generala (una sola vez) con:
#   python -c "import secrets; print(secrets.token_hex(32))"
CLAVE_HASH=

# Política de privacidad (se publica en /privacidad)
PRIVACIDAD_RESPONSABLE=
PRIVACIDAD_CONTACTO=
PRIVACIDAD_URL=
